{
  "name": "botspector",
  "version": "0.1.1",
  "description": "BotSpector — a quirky desktop sidekick that snoops through your Azure DevOps pull requests with a GitHub Copilot-powered agent.",
  "main": "./out/main/index.js",
  "author": "GCAP",
  "license": "MIT",
  "build": {
    "appId": "com.gcap.botspector",
    "productName": "BotSpector",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/icon.ico",
          "to": "icon.ico"
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ]
    }
  },
  "scripts": {
    "dev": "node scripts/patch-electron-name.mjs && electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:dependencies": "npm audit --audit-level=high",
    "security:secrets": "secretlint \"**/*\" \".azdo/**/*\" \".github/**/*\"",
    "security": "npm run security:dependencies && npm run security:secrets",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "check": "npm run format:check && npm run lint && npm run test:coverage && npm run typecheck && npm run security",
    "postinstall": "electron-builder install-app-deps && node scripts/patch-electron-name.mjs",
    "package": "electron-vite build && electron-builder",
    "package:release": "electron-vite build && electron-builder --config electron-builder.release.mjs",
    "release:verify-tag": "node scripts/verify-release-tag.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^13.0.3",
    "diff": "^5.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/diff": "^5.2.3",
    "@types/node": "^20.17.24",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.12",
    "electron": "^44.0.0-beta.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "secretlint": "^13.0.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.10",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}
